---
const links = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
];
---

<header id="nav" class="nav">
  <div class="container nav-inner">
    <a href="#hero" class="brand" aria-label="Septian Yoga — home">
      <span class="brand-top">Flutter Developer</span>
      <span class="brand-bottom">Mobile Engineer</span>
    </a>

    <nav class="links" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href}>
            <span>{l.label}</span>
          </a>
        ))
      }
    </nav>

    <a href="#contact" class="avail">
      <span>Available for opportunities</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 0c.7 6.6 5.4 11.3 12 12-6.6.7-11.3 5.4-12 12-.7-6.6-5.4-11.3-12-12C6.6 11.3 11.3 6.6 12 0z"></path>
      </svg>
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    padding-block: 22px;
    transition:
      padding 0.4s var(--ease-out-quart),
      background 0.4s,
      border-color 0.4s;
    border-bottom: 1px solid transparent;
    animation: navIn 1s var(--ease-out-expo) 0.2s both;
  }
  .nav.scrolled {
    padding-block: 12px;
    background: rgba(5, 4, 4, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-color: rgba(225, 29, 39, 0.18);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    font-family: var(--font-display);
    text-transform: uppercase;
    transition: opacity 0.3s;
  }
  .brand:hover {
    opacity: 0.75;
  }
  .brand-top {
    color: var(--color-crimson);
    font-size: 12px;
    letter-spacing: 0.12em;
  }
  .brand-bottom {
    color: var(--color-heading);
    font-size: 11px;
    letter-spacing: 0.18em;
    opacity: 0.8;
  }
  .links {
    display: none;
    gap: 6px;
  }
  .links a {
    position: relative;
    padding: 8px 14px;
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-sub);
    transition: color 0.3s;
  }
  .links a::after {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 2px;
    height: 1px;
    background: var(--color-crimson);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out-quart);
  }
  .links a:hover,
  .links a.active {
    color: #fff;
  }
  .links a:hover::after,
  .links a.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-sub);
  }
  .avail svg {
    color: var(--color-crimson);
    animation: spin 6s linear infinite;
  }
  .avail span {
    display: none;
  }
  @media (min-width: 640px) {
    .avail span {
      display: inline;
    }
  }
  @media (min-width: 900px) {
    .links {
      display: flex;
    }
  }
  @keyframes navIn {
    from {
      opacity: 0;
      transform: translateY(-24px);
    }
  }
</style>

<script>
  const nav = document.getElementById("nav")!;
  const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 40);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Active link highlighting
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".links a"));
  const map = new Map<string, HTMLAnchorElement>();
  links.forEach((a) => map.set(a.getAttribute("href")!.slice(1), a));
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          links.forEach((l) => l.classList.remove("active"));
          map.get(e.target.id)?.classList.add("active");
        }
      });
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  map.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) spy.observe(el);
  });
</script>
