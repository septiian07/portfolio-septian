---
---

<section
  class="flex flex-col items-start justify-center min-h-[85vh] animate-fade-in-up relative"
>
  <!-- Decorative Ambient Blur -->
  <div
    class="absolute -top-32 -left-32 w-64 h-64 bg-cyan-500/20 blur-[100px] rounded-full pointer-events-none"
  >
  </div>

  <div
    class="inline-flex items-center px-4 py-2 mb-8 rounded-full glass border border-cyan-500/30 text-cyan-400 text-sm font-semibold tracking-widest uppercase shadow-[0_0_20px_rgba(34,211,238,0.15)] relative overflow-hidden group"
  >
    <div
      class="absolute inset-0 bg-gradient-to-r from-cyan-500/0 via-cyan-500/10 to-cyan-500/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000"
    >
    </div>
    <span
      class="w-2.5 h-2.5 rounded-full bg-cyan-400 mr-3 animate-pulse shadow-[0_0_8px_rgba(34,211,238,0.8)]"
    ></span>
    Available for new opportunities
  </div>

  <h1
    class="text-6xl md:text-8xl lg:text-9xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-br from-white via-slate-200 to-slate-500 mb-6 leading-[1] drop-shadow-2xl"
  >
    Septian Yoga<span class="text-cyan-500 text-glow">.</span>
  </h1>

  <h2
    class="text-3xl md:text-5xl lg:text-6xl font-medium text-slate-400 mb-8 tracking-tight"
  >
    Flutter Developer
  </h2>

  <p
    class="text-xl md:text-2xl text-slate-400 max-w-3xl mb-12 leading-relaxed font-light"
  >
    Engineering highly performant, scalable mobile experiences with technical
    precision. Specializing in Clean Architecture, MVVM, and seamless
    cross-platform delivery.
  </p>

  <div class="flex flex-wrap gap-6">
    <a
      href="#contact"
      class="group relative px-10 py-5 rounded-2xl bg-cyan-500 text-slate-950 font-bold hover:bg-cyan-400 transition-all shadow-[0_0_30px_rgba(34,211,238,0.4)] hover:shadow-[0_0_50px_rgba(34,211,238,0.6)] hover:-translate-y-1 ease-out duration-300 overflow-hidden text-lg"
    >
      <div
        class="absolute inset-0 bg-white/20 translate-y-[100%] group-hover:translate-y-[0%] transition-transform duration-300 ease-out"
      >
      </div>
      <span class="relative">Contact Me</span>
    </a>
    <a
      href="https://drive.google.com/file/d/1bKknQcs_JxHEYUf7Bjm_2UOjc31YWebW/view?usp=sharing"
      target="_blank"
      rel="noopener noreferrer"
      class="px-10 py-5 rounded-2xl glass border border-white/10 text-white font-medium hover:border-cyan-500/50 hover:bg-cyan-950/30 hover:text-cyan-300 transition-all hover:shadow-[0_0_30px_rgba(34,211,238,0.2)] hover:-translate-y-1 ease-out duration-300 text-lg"
    >
      Download CV
    </a>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
