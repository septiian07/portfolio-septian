---
const items = [
  {
    label: "Email",
    value: "septianpermadi0709@gmail.com",
    href: "mailto:septianpermadi0709@gmail.com",
    icon: "M3 7l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z",
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/septian-yoga",
    href: "https://www.linkedin.com/in/septian-yoga/",
    icon: "M4 9h4v11H4zM6 4a2 2 0 110 4 2 2 0 010-4zM10 9h4v1.6c.6-1 1.9-1.9 3.6-1.9C21 8.7 21 11.5 21 13.5V20h-4v-5.7c0-1.4 0-2.8-1.7-2.8s-1.8 1.300-1.8 2.700V20h-4z",
  },
  {
    label: "GitHub",
    value: "github.com/septiian07",
    href: "https://github.com/septiian07",
    icon: "M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.400-.5-2 2.800-.3 5.500-1.400 5.500-6a4.600 4.600 0 00-1.300-3.200 4.200 4.200 0 00-.1-3.200s-1.100-.3-3.500 1.300a12.300 12.300 0 00-6.200 0C6.500 2.800 5.400 3.100 5.400 3.100a4.200 4.200 0 00-.1 3.200A4.600 4.600 0 004 9.500c0 4.600 2.700 5.700 5.500 6-.6.600-.6 1.200-.5 2V21",
  },
  {
    label: "Location",
    value: "Bandung, Indonesia",
    href: "https://maps.google.com/?q=Bandung,Indonesia",
    icon: "M12 22s7-6.2 7-12a7 7 0 10-14 0c0 5.800 7 12 7 12zM12 12.500a2.500 2.500 0 100-5 2.500 2.500 0 000 5z",
  },
];
---

<section id="contact" class="section">
  <div class="container">
    <div class="panel">
      <div class="panel-glow" aria-hidden="true"></div>

      <div class="left">
        <p class="label label-red" data-reveal>Get in touch</p>
        <h2 class="display big" data-reveal style="--d: 0.08s">
          Let's work<br />together<svg class="spark" width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c.7 6.6 5.4 11.3 12 12-6.6.7-11.3 5.4-12 12-.7-6.6-5.4-11.3-12-12C6.6 11.3 11.3 6.6 12 0z"></path></svg>
        </h2>
        <p class="copy" data-reveal style="--d: 0.16s">
          I'm currently open to new projects and collaborations. Whether you have
          a specific idea, a question, or just want to connect — let's create
          something amazing that drives results.
        </p>
        <a
          class="btn btn-red"
          data-reveal
          style="--d: 0.24s"
          href="mailto:septianpermadi0709@gmail.com"
        >
          Say hello
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>

      <ul class="list">
        {
          items.map((it, i) => (
            <li data-reveal style={`--d:${0.1 + i * 0.09}s`}>
              <a href={it.href} target={it.href.startsWith("mailto") ? undefined : "_blank"} rel="noopener noreferrer">
                <span class="ic">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={it.icon} />
                  </svg>
                </span>
                <span class="txt">
                  <small>{it.label}</small>
                  {it.value}
                </span>
                <svg class="go" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="visual" data-reveal="right" style="--d: 0.2s" aria-hidden="true">
        <img src="/assets/laptop.jpg" alt="" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    display: grid;
    gap: 48px;
    padding: clamp(28px, 5vw, 64px);
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(180deg, var(--color-raised-2), var(--color-base));
  }
  .panel-glow {
    position: absolute;
    z-index: -1;
    left: -10%;
    bottom: -40%;
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(225, 29, 39, 0.28), transparent 65%);
    filter: blur(40px);
    animation: glowMove 10s ease-in-out infinite alternate;
  }
  @media (min-width: 1000px) {
    .panel {
      grid-template-columns: 1fr 1fr;
    }
    .visual {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1240px) {
    .panel {
      grid-template-columns: 1fr 0.9fr 1.1fr;
      align-items: center;
    }
    .visual {
      grid-column: auto;
      margin: -64px -64px -64px 0;
      align-self: stretch;
    }
  }
  .big {
    margin-top: 14px;
    font-size: clamp(2.8rem, 5.4vw, 4.6rem);
  }
  .spark {
    display: inline-block;
    margin-left: 12px;
    color: var(--color-crimson);
    vertical-align: super;
    animation: spin 6s linear infinite;
  }
  .copy {
    margin: 22px 0 28px;
    max-width: 42ch;
    font-size: 15px;
    line-height: 1.8;
  }
  .list {
    list-style: none;
    display: grid;
    gap: 4px;
  }
  .list a {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 8px;
    border-bottom: 1px solid var(--color-rule-subtle);
    color: var(--color-heading);
    font-size: 14.5px;
    transition:
      padding 0.4s var(--ease-out-quart),
      background 0.3s,
      border-color 0.3s;
  }
  .list a:hover {
    padding-left: 18px;
    background: rgba(225, 29, 39, 0.07);
    border-color: var(--color-crimson);
  }
  .ic {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(225, 29, 39, 0.6);
    color: var(--color-crimson-hot);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .list a:hover .ic {
    background: var(--color-crimson);
    color: #fff;
  }
  .txt {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .txt small {
    display: block;
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ghost);
    margin-bottom: 2px;
  }
  .go {
    color: var(--color-ghost);
    transition:
      transform 0.4s var(--ease-out-quart),
      color 0.3s;
  }
  .list a:hover .go {
    color: var(--color-crimson-hot);
    transform: translate(3px, -3px);
  }
  .visual {
    position: relative;
    min-height: 260px;
    overflow: hidden;
    border-radius: 4px;
  }
  .visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out-quart);
    mask-image: linear-gradient(to right, transparent, #000 25%);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 25%);
  }
  .panel:hover .visual img {
    transform: scale(1.06);
  }
  @keyframes glowMove {
    to {
      transform: translate(40%, -20%) scale(1.2);
    }
  }
</style>
