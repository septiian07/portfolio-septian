---
---

<section id="contact" class="scroll-mt-32">
  <div class="flex items-center gap-6 mb-16">
    <h2 class="text-4xl font-extrabold text-white tracking-tight">Let's Work Together</h2>
    <div class="h-px flex-grow bg-gradient-to-r from-cyan-500/30 to-transparent"></div>
  </div>

  <div class="glass p-12 md:p-20 rounded-[3rem] relative overflow-hidden border border-white/5 group transition-all duration-1000 hover:border-cyan-500/30 hover:shadow-[0_0_80px_rgba(6,182,212,0.1)]">
    <!-- Sophisticated Background Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-gradient-to-br from-cyan-500/5 via-transparent to-violet-500/5 blur-[150px] pointer-events-none group-hover:from-cyan-500/10 group-hover:to-violet-500/10 transition-all duration-1000"></div>
    
    <div class="relative z-10 grid lg:grid-cols-2 gap-20 items-center">
      
      <!-- Connect Side -->
      <div class="space-y-10">
        <div>
          <h3 class="text-4xl font-black text-white tracking-tighter mb-6 leading-tight">Have a project <br /> in mind?</h3>
          <p class="text-slate-400 text-xl leading-relaxed font-light">
            I'm currently exploring new opportunities. Whether you have a specific project, a question, or just want to connect, I'm always open to talking tech.
          </p>
        </div>
        
        <div class="space-y-6">
          <a href="mailto:septianpermadi0709@gmail.com" class="group/mail flex items-center gap-5 p-6 rounded-[2rem] glass border border-white/5 hover:border-cyan-500/40 hover:bg-cyan-950/20 transition-all duration-300">
            <div class="w-14 h-14 rounded-2xl bg-slate-900 border border-white/10 flex items-center justify-center group-hover/mail:neon-glow-cyan transition-all duration-500">
              <svg class="w-7 h-7 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold text-slate-500 uppercase tracking-widest mb-1">Email Me</p>
              <p class="text-lg font-bold text-white group-hover/mail:text-cyan-300 transition-colors">septianpermadi0709@gmail.com</p>
            </div>
          </a>
          
          <!-- Social Links -->
          <div class="flex gap-4">
            <a href="https://www.linkedin.com/in/septian-yoga/" target="_blank" rel="noopener noreferrer" class="w-14 h-14 rounded-2xl glass border border-white/5 flex items-center justify-center text-slate-400 hover:text-[#0a66c2] hover:border-[#0a66c2]/50 hover:bg-[#0a66c2]/10 transition-all duration-300 group/social" aria-label="LinkedIn">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="https://github.com/septiian07" target="_blank" rel="noopener noreferrer" class="w-14 h-14 rounded-2xl glass border border-white/5 flex items-center justify-center text-slate-400 hover:text-white hover:border-white/30 hover:bg-white/10 transition-all duration-300 group/social" aria-label="GitHub">
              <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Form Side -->
      <form class="space-y-8" onsubmit="event.preventDefault();">
        <div class="grid sm:grid-cols-2 gap-8">
          <div class="space-y-3">
            <label for="name" class="text-sm font-bold text-slate-400 uppercase tracking-widest ml-1">Name</label>
            <input type="text" id="name" placeholder="Septian Yoga" class="w-full bg-slate-900/50 border border-white/10 rounded-2xl px-6 py-5 text-white placeholder-slate-600 focus:outline-none focus:border-cyan-500/50 focus:ring-4 focus:ring-cyan-500/5 transition-all shadow-inner text-lg font-light" />
          </div>
          <div class="space-y-3">
            <label for="email" class="text-sm font-bold text-slate-400 uppercase tracking-widest ml-1">Email</label>
            <input type="email" id="email" placeholder="example@email.com" class="w-full bg-slate-900/50 border border-white/10 rounded-2xl px-6 py-5 text-white placeholder-slate-600 focus:outline-none focus:border-cyan-500/50 focus:ring-4 focus:ring-cyan-500/5 transition-all shadow-inner text-lg font-light" />
          </div>
        </div>
        
        <div class="space-y-3">
          <label for="message" class="text-sm font-bold text-slate-400 uppercase tracking-widest ml-1">Message</label>
          <textarea id="message" rows="5" placeholder="Let's build something extraordinary..." class="w-full bg-slate-900/50 border border-white/10 rounded-[2rem] px-6 py-5 text-white placeholder-slate-600 focus:outline-none focus:border-cyan-500/50 focus:ring-4 focus:ring-cyan-500/5 transition-all shadow-inner resize-none text-lg font-light"></textarea>
        </div>
        
        <button type="submit" class="w-full py-6 rounded-[2rem] glass border border-white/10 text-white font-black text-xl hover:border-cyan-500/50 hover:bg-cyan-500/10 hover:text-cyan-300 transition-all hover:shadow-[0_0_40px_rgba(34,211,238,0.2)] active:scale-[0.98] duration-300 tracking-tighter">
          Send Message
        </button>
      </form>
      
    </div>
  </div>
</section>
