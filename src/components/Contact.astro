---
---

<section id="contact" class="scroll-mt-32" style="margin-top: 160px;">
  <div class="bg-raised p-12 md:p-20 relative">
    <div class="font-label text-[11px] uppercase tracking-[0.1em] text-muted mb-12">
      Get in Touch
    </div>

    <div class="grid lg:grid-cols-2 gap-20 items-start">

      <!-- Connect Side -->
      <div class="space-y-10">
        <div>
          <h3
            class="font-serif text-heading font-bold italic tracking-tight mb-6 leading-[1.15]"
            style="font-size: clamp(2rem, 3.5vw, 2.75rem);"
          >
            Have a project<br />in mind?
          </h3>
          <p class="text-body text-lg leading-[1.8]">
            I'm currently exploring new opportunities. Whether you have a specific project, a question, or just want to connect, I'm always open to talking tech.
          </p>
        </div>

        <div class="space-y-5">
          <a
            href="mailto:septianpermadi0709@gmail.com"
            class="group flex items-center gap-5 py-4 transition-opacity duration-300 hover:opacity-70"
            style="border-bottom: 1px solid var(--color-rule-subtle);"
          >
            <svg class="w-5 h-5 text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div>
              <p class="font-label text-[10px] uppercase tracking-[0.1em] text-ghost mb-1">Email Me</p>
              <p class="text-heading font-medium">septianpermadi0709@gmail.com</p>
            </div>
          </a>

          <!-- Social Links -->
          <div class="flex gap-4 pt-2">
            <a
              href="https://www.linkedin.com/in/septian-yoga/"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center text-ghost hover:text-heading transition-colors duration-300"
              style="border: 1px solid var(--color-rule-subtle); border-radius: 0.25rem;"
              aria-label="LinkedIn"
            >
              <svg class="w-4.5 h-4.5 fill-current" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a
              href="https://github.com/septiian07"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center text-ghost hover:text-heading transition-colors duration-300"
              style="border: 1px solid var(--color-rule-subtle); border-radius: 0.25rem;"
              aria-label="GitHub"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Form Side -->
      <form class="space-y-8" onsubmit="event.preventDefault();">
        <div class="grid sm:grid-cols-2 gap-8">
          <div class="space-y-2">
            <label for="name" class="font-label text-[10px] uppercase tracking-[0.1em] text-ghost">Name</label>
            <input
              type="text"
              id="name"
              placeholder="Septian Yoga"
              class="w-full bg-transparent text-heading placeholder-ghost py-3 text-base focus:outline-none transition-colors duration-300"
              style="border-bottom: 1px solid var(--color-rule-subtle); border-top: none; border-left: none; border-right: none;"
              onfocus="this.style.borderBottomColor='var(--color-sub)'"
              onblur="this.style.borderBottomColor='var(--color-rule-subtle)'"
            />
          </div>
          <div class="space-y-2">
            <label for="email" class="font-label text-[10px] uppercase tracking-[0.1em] text-ghost">Email</label>
            <input
              type="email"
              id="email"
              placeholder="example@email.com"
              class="w-full bg-transparent text-heading placeholder-ghost py-3 text-base focus:outline-none transition-colors duration-300"
              style="border-bottom: 1px solid var(--color-rule-subtle); border-top: none; border-left: none; border-right: none;"
              onfocus="this.style.borderBottomColor='var(--color-sub)'"
              onblur="this.style.borderBottomColor='var(--color-rule-subtle)'"
            />
          </div>
        </div>

        <div class="space-y-2">
          <label for="message" class="font-label text-[10px] uppercase tracking-[0.1em] text-ghost">Message</label>
          <textarea
            id="message"
            rows="4"
            placeholder="Let's build something extraordinary..."
            class="w-full bg-transparent text-heading placeholder-ghost py-3 text-base focus:outline-none resize-none transition-colors duration-300"
            style="border-bottom: 1px solid var(--color-rule-subtle); border-top: none; border-left: none; border-right: none;"
            onfocus="this.style.borderBottomColor='var(--color-sub)'"
            onblur="this.style.borderBottomColor='var(--color-rule-subtle)'"
          ></textarea>
        </div>

        <button
          type="submit"
          class="px-8 py-3.5 bg-inv text-inv-on font-sans font-semibold text-sm tracking-tight rounded-[0.25rem] hover:opacity-80 transition-opacity duration-[400ms]"
        >
          Send Message
        </button>
      </form>

    </div>
  </div>
</section>
