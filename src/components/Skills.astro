---
const skillCategories = [
  {
    category: "Mobile Frameworks & Languages",
    skills: ["Dart", "Flutter"]
  },
  {
    category: "Architecture & State Management",
    skills: ["MVVM", "Stacked", "GetX", "BLoC"]
  },
  {
    category: "Advanced Integrations",
    skills: ["Google ML Kit (Face Detection)", "Location-Based Services (LBS)", "Firebase (FCM, Analytics, Crashlytics)", "Mock Location Detection"]
  },
  {
    category: "Backend & APIs",
    skills: ["Dio & Retrofit", "Java Springboot", "JWT", "RESTful APIs"]
  },
  {
    category: "Tools & Workflow",
    skills: ["GitHub", "GitLab", "Slack", "Trello", "ClickUp", "Figma to Code"]
  }
];
---

<section id="skills" class="scroll-mt-32">
  <div class="flex items-center gap-6 mb-16">
    <h2 class="text-4xl font-extrabold text-white tracking-tight">Technical Skills</h2>
    <div class="h-px flex-grow bg-gradient-to-r from-cyan-500/30 to-transparent"></div>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
    {skillCategories.map((group) => (
      <div class="glass p-10 rounded-[2.5rem] hover:glass-hover transition-all duration-500 border border-white/5 hover:border-cyan-500/30 group relative overflow-hidden shadow-2xl hover:shadow-[0_0_50px_rgba(6,182,212,0.15)] hover:-translate-y-1">
        <!-- Background Accent Glow -->
        <div class="absolute -bottom-16 -right-16 w-40 h-40 bg-cyan-500/10 blur-[50px] rounded-full pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        
        <h3 class="text-2xl font-bold text-slate-100 mb-8 group-hover:text-cyan-300 transition-colors tracking-tight leading-tight">{group.category}</h3>
        
        <div class="flex flex-wrap gap-3.5 relative z-10">
          {group.skills.map((skill) => (
            <span class="px-5 py-2.5 bg-slate-900/60 border border-slate-700/40 text-cyan-400 text-base font-semibold rounded-2xl shadow-sm hover:border-cyan-400/50 hover:bg-cyan-950/30 hover:text-cyan-200 hover:shadow-[0_0_20px_rgba(6,182,212,0.3)] transition-all cursor-default tracking-wide">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
