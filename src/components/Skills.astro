---
const skillCategories = [
  {
    category: "Mobile Frameworks & Languages",
    skills: ["Dart", "Flutter"]
  },
  {
    category: "Architecture & State Management",
    skills: ["MVVM", "Stacked", "GetX", "BLoC"]
  },
  {
    category: "Advanced Integrations",
    skills: ["Google ML Kit (Face Detection)", "Location-Based Services (LBS)", "Firebase (FCM, Analytics, Crashlytics)", "Mock Location Detection"]
  },
  {
    category: "Backend & APIs",
    skills: ["Dio & Retrofit", "Java Springboot", "JWT", "RESTful APIs"]
  },
  {
    category: "Tools & Workflow",
    skills: ["GitHub", "GitLab", "Slack", "Trello", "ClickUp", "Figma to Code"]
  }
];
---

<section id="skills" class="scroll-mt-32" style="margin-top: 160px;">
  <div class="font-label text-[11px] uppercase tracking-[0.1em] text-muted mb-16">
    Technical Skills
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-12 md:gap-16">
    {skillCategories.map((group) => (
      <div>
        <h3 class="font-serif text-heading font-semibold text-lg tracking-tight mb-6 leading-tight">
          {group.category}
        </h3>

        <div class="flex flex-wrap gap-2.5">
          {group.skills.map((skill) => (
            <span
              class="font-label text-[11px] tracking-[0.08em] text-sub px-3 py-1.5 rounded-[0.25rem] transition-colors duration-300 hover:text-heading"
              style="border: 1px solid var(--color-rule);"
            >
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
