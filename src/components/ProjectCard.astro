---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  link: string;
  playStore?: string;
  appStore?: string;
  github?: string;
}

const { slug, title, description, tags, link, playStore, appStore, github } = Astro.props;

const previewPath = path.join(process.cwd(), 'public', 'assets', 'projects', slug, 'main-preview.png');
const hasPreview = fs.existsSync(previewPath);
---

<div class={`glass p-8 md:p-12 rounded-3xl group transition-all duration-700 ease-out flex flex-col ${hasPreview ? 'xl:flex-row gap-10 xl:gap-16' : ''} relative overflow-hidden border border-white/5 hover:border-cyan-500/30`}>
  <!-- Background Ambient Glow -->
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-cyan-500/10 blur-[100px] rounded-full pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-violet-500/10 blur-[100px] rounded-full pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
  
  <!-- Project Details (Left / Top) -->
  <div class={`relative z-10 flex flex-col ${hasPreview ? 'xl:w-1/2 shrink-0' : 'w-full'}`}>
    <div class="flex justify-between items-start mb-6">
      <div class="w-12 h-12 rounded-xl bg-slate-900 border border-white/10 flex items-center justify-center shadow-lg group-hover:neon-glow-cyan transition-all duration-500">
        <svg class="w-6 h-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
        </svg>
      </div>
      
      <a href={link} class="text-slate-500 hover:text-cyan-400 transition-colors p-2 -mr-2 bg-slate-900/50 hover:bg-slate-900 rounded-full border border-transparent hover:border-cyan-500/30" aria-label="View Project">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
    
    <h3 class="text-3xl font-bold text-slate-100 mb-4 group-hover:text-cyan-300 transition-colors duration-300 tracking-tight">{title}</h3>
    
    <p class="text-slate-400 text-lg leading-relaxed mb-8 flex-grow">
      {description}
    </p>

    { (playStore || appStore || github) && (
      <div class="flex flex-wrap gap-3 mb-8">
        {playStore && (
          <a href={playStore} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-5 py-2.5 bg-slate-900/80 border border-white/10 rounded-xl hover:border-cyan-500/50 hover:bg-cyan-500/10 transition-all group/btn">
            <svg class="w-5 h-5 text-slate-400 group-hover/btn:text-cyan-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.31-.692V2.506c0-.261.101-.522.309-.692zM14.735 12.943l-2.029-2.029L3.922 2.13c.181-.11.393-.17.614-.17a.992.992 0 0 1 .494.132l11.455 6.444-1.75 1.75v2.657zm1.751-1.751l3.528 1.984c.48.27.48.744 0 1.014l-3.528 1.984-1.751-1.75 1.751-3.232zm-1.751 4.282l2.029-2.029 8.784 8.784a.992.992 0 0 1-.614.17.992.992 0 0 1-.494-.132l-11.455-6.444 1.75-1.75v2.657z"/>
            </svg>
            <span class="text-sm font-semibold text-slate-300 group-hover/btn:text-cyan-300">Play Store</span>
          </a>
        )}
        {appStore && (
          <a href={appStore} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-5 py-2.5 bg-slate-900/80 border border-white/10 rounded-xl hover:border-violet-500/50 hover:bg-violet-500/10 transition-all group/btn">
            <svg class="w-5 h-5 text-slate-400 group-hover/btn:text-violet-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.06.75.79-.03 1.94-.78 3.39-.67 1.86.12 3.2 1.03 3.98 2.45-3.66 1.98-3.08 6.57.51 8.08-.66 1.63-1.63 3.27-2.94 4.36zM12.03 7.25c-.13-2.13 1.8-4.14 3.93-4.25.32 2.42-2.12 4.41-3.93 4.25z"/>
            </svg>
            <span class="text-sm font-semibold text-slate-300 group-hover/btn:text-violet-300">App Store</span>
          </a>
        )}
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-5 py-2.5 bg-slate-900/80 border border-white/10 rounded-xl hover:border-white/40 hover:bg-white/10 transition-all group/btn">
            <svg class="w-5 h-5 text-slate-400 group-hover/btn:text-white" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span class="text-sm font-semibold text-slate-300 group-hover/btn:text-white">GitHub</span>
          </a>
        )}
      </div>
    )}
    
    <div class="flex flex-wrap gap-2 mt-auto">
      {tags.map((tag) => (
        <span class="text-xs font-medium tracking-wide text-cyan-300 bg-cyan-950/40 px-3 py-1.5 rounded-full border border-cyan-500/20 backdrop-blur-sm shadow-[0_0_10px_rgba(6,182,212,0.1)]">
          {tag}
        </span>
      ))}
    </div>
  </div>
  
  <!-- Singular Project Preview (Right / Bottom) -->
  {hasPreview && (
    <div class="relative z-10 xl:w-1/2 flex-grow mt-8 xl:mt-0">
      <div class="relative group/img aspect-video bg-slate-900 rounded-2xl md:rounded-[2rem] border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] overflow-hidden transition-all duration-700 hover:border-cyan-500/50 hover:shadow-[0_0_50px_rgba(6,182,212,0.2)] hover:-translate-y-2">
        
        <!-- Single Main Preview Image -->
        <img 
          src={`/assets/projects/${slug}/main-preview.png`} 
          alt={`${title} Main Preview`}
          class="w-full h-full object-cover transition-transform duration-1000 group-hover/img:scale-105 opacity-80 group-hover/img:opacity-100"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        
        <!-- Fallback Skeleton UI (shows if image fails to load) -->
        <div class="absolute inset-0 hidden flex-col items-center justify-center bg-gradient-to-br from-slate-800 to-slate-900">
          <svg class="w-16 h-16 text-slate-700 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="text-sm text-slate-500 font-mono text-center px-10">/assets/projects/{slug}/main-preview.png</span>
        </div>
        
        <!-- Glossy Overlay -->
        <div class="absolute inset-0 bg-gradient-to-tr from-white/5 via-transparent to-transparent pointer-events-none"></div>
      </div>
    </div>
  )}
</div>
