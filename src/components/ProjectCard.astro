---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  link: string;
  playStore?: string;
  appStore?: string;
  github?: string;
}

const { slug, title, description, tags, link, playStore, appStore, github } = Astro.props;

const previewPath = path.join(process.cwd(), 'public', 'assets', 'projects', slug, 'main-preview.png');
const hasPreview = fs.existsSync(previewPath);
---

<div
  class="group flex flex-col bg-raised transition-opacity duration-[400ms] ease-[var(--ease-out-quart)] opacity-[0.85] hover:opacity-100"
>
  {/* Preview image area */}
  {hasPreview ? (
    <div class="relative aspect-[16/10] overflow-hidden bg-raised-2">
      <img
        src={`/assets/projects/${slug}/main-preview.png`}
        alt={`${title} preview`}
        class="w-full h-full object-cover transition-transform duration-[600ms] ease-[var(--ease-out-quart)] group-hover:scale-[1.03]"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <div class="absolute inset-0 hidden flex-col items-center justify-center bg-raised-2">
        <svg class="w-12 h-12 text-ghost mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="text-xs text-ghost font-label">{slug}</span>
      </div>
    </div>
  ) : (
    <div class="aspect-[16/10] bg-raised-2 flex items-center justify-center">
      <svg class="w-10 h-10 text-raised-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
      </svg>
    </div>
  )}

  {/* Content */}
  <div class="flex flex-col flex-grow p-7">
    <div class="flex justify-between items-start mb-3">
      <h3 class="font-serif text-heading font-semibold text-xl tracking-tight group-hover:text-sub transition-colors duration-[400ms]">
        {title}
      </h3>
      <a
        href={link}
        class="text-ghost hover:text-heading transition-colors duration-300 shrink-0 ml-3"
        aria-label="View Project"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <p class="text-muted text-sm leading-relaxed mb-5 flex-grow">
      {description}
    </p>

    {(playStore || appStore || github) && (
      <div class="flex flex-wrap gap-2 mb-5">
        {playStore && (
          <a href={playStore} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 px-3 py-1.5 text-ghost hover:text-heading transition-colors duration-300" style="border: 1px solid var(--color-rule-subtle); border-radius: 0.25rem;">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.31-.692V2.506c0-.261.101-.522.309-.692zM14.735 12.943l-2.029-2.029L3.922 2.13c.181-.11.393-.17.614-.17a.992.992 0 0 1 .494.132l11.455 6.444-1.75 1.75v2.657zm1.751-1.751l3.528 1.984c.48.27.48.744 0 1.014l-3.528 1.984-1.751-1.75 1.751-3.232zm-1.751 4.282l2.029-2.029 8.784 8.784a.992.992 0 0 1-.614.17.992.992 0 0 1-.494-.132l-11.455-6.444 1.75-1.75v2.657z"/>
            </svg>
            <span class="font-label text-[10px] tracking-[0.05em]">Play Store</span>
          </a>
        )}
        {appStore && (
          <a href={appStore} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 px-3 py-1.5 text-ghost hover:text-heading transition-colors duration-300" style="border: 1px solid var(--color-rule-subtle); border-radius: 0.25rem;">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.06.75.79-.03 1.94-.78 3.39-.67 1.86.12 3.2 1.03 3.98 2.45-3.66 1.98-3.08 6.57.51 8.08-.66 1.63-1.63 3.27-2.94 4.36zM12.03 7.25c-.13-2.13 1.8-4.14 3.93-4.25.32 2.42-2.12 4.41-3.93 4.25z"/>
            </svg>
            <span class="font-label text-[10px] tracking-[0.05em]">App Store</span>
          </a>
        )}
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 px-3 py-1.5 text-ghost hover:text-heading transition-colors duration-300" style="border: 1px solid var(--color-rule-subtle); border-radius: 0.25rem;">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span class="font-label text-[10px] tracking-[0.05em]">GitHub</span>
          </a>
        )}
      </div>
    )}

    <div class="flex flex-wrap gap-2 mt-auto">
      {tags.map((tag) => (
        <span
          class="font-label text-[10px] tracking-[0.08em] text-ghost px-2.5 py-1 rounded-[0.125rem]"
          style="border: 1px solid var(--color-rule);"
        >
          {tag}
        </span>
      ))}
    </div>
  </div>
</div>
