---
import fs from "node:fs";
import path from "node:path";

interface Props {
  slug: string;
  title: string;
  kind?: string;
  description: string;
  tags: string[];
  link: string;
  playStore?: string;
  appStore?: string;
  github?: string;
  index: number;
}

const { slug, title, kind, description, tags, link, playStore, appStore, github, index } =
  Astro.props;

const previewPath = path.join(process.cwd(), "public", "assets", "projects", slug, "main-preview.png");
const hasPreview = fs.existsSync(previewPath);
const num = String(index).padStart(2, "0");
const external = link && link !== "#";
---

<article class="card" data-tilt>
  <div class="shine"></div>

  <div class="media">
    {
      hasPreview ? (
        <img src={`/assets/projects/${slug}/main-preview.png`} alt={`${title} preview`} loading="lazy" />
      ) : (
        <div class="fallback" aria-hidden="true">
          <span class="ghost-num">{num}</span>
          <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2.5"></rect><path d="M11 18.5h2"></path></svg>
        </div>
      )
    }
    <span class="badge">{num}</span>
  </div>

  <div class="body">
    <div class="head">
      <div>
        <h3>{title}</h3>
        {kind && <p class="kind">{kind}</p>}
      </div>
      {
        external && (
          <a href={link} target="_blank" rel="noopener noreferrer" class="arrow" aria-label={`Open ${title}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 17L17 7M8 7h9v9"></path></svg>
          </a>
        )
      }
    </div>

    <p class="desc">{description}</p>

    {
      (playStore || appStore || github) && (
        <div class="stores">
          {playStore && <a href={playStore} target="_blank" rel="noopener noreferrer">Play Store</a>}
          {appStore && <a href={appStore} target="_blank" rel="noopener noreferrer">App Store</a>}
          {github && <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>}
        </div>
      )
    }

    <div class="tags">
      {tags.map((t) => <span>{t}</span>)}
    </div>
  </div>
</article>

<style>
  .card {
    --rx: 0deg;
    --ry: 0deg;
    --gx: 50%;
    --gy: 50%;
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, var(--color-raised-2), var(--color-raised));
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    overflow: hidden;
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transition:
      transform 0.35s var(--ease-out-quart),
      border-color 0.4s,
      box-shadow 0.5s;
    will-change: transform;
  }
  .card:hover {
    border-color: rgba(225, 29, 39, 0.55);
    box-shadow: 0 30px 70px -30px rgba(225, 29, 39, 0.55);
  }
  .shine {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
    background: radial-gradient(360px circle at var(--gx) var(--gy), rgba(255, 70, 80, 0.16), transparent 60%);
  }
  .card:hover .shine {
    opacity: 1;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0a0606;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) brightness(0.9);
    transition:
      transform 0.8s var(--ease-out-quart),
      filter 0.5s;
  }
  .card:hover .media img {
    transform: scale(1.07);
    filter: saturate(1.1) brightness(1);
  }
  .media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-raised) 2%, transparent 55%);
    pointer-events: none;
  }
  .fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(225, 29, 39, 0.7);
    background:
      radial-gradient(circle at 70% 20%, rgba(225, 29, 39, 0.35), transparent 55%),
      radial-gradient(circle at 10% 90%, rgba(110, 10, 17, 0.6), transparent 60%),
      linear-gradient(135deg, #160b0c, #0a0505);
    overflow: hidden;
  }
  .fallback svg {
    transition: transform 0.6s var(--ease-out-quart);
  }
  .card:hover .fallback svg {
    transform: scale(1.18) rotate(-6deg);
  }
  .ghost-num {
    position: absolute;
    right: -4%;
    bottom: -22%;
    font-family: var(--font-display);
    font-size: 11rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(225, 29, 39, 0.3);
    transition: transform 0.7s var(--ease-out-quart);
  }
  .card:hover .ghost-num {
    transform: translate(-10px, -10px);
  }
  .badge {
    position: absolute;
    left: 18px;
    top: 14px;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 1.7rem;
    color: var(--color-crimson);
    line-height: 1;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.8);
  }

  .body {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 6px 24px 24px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.45rem;
    line-height: 1.1;
    color: var(--color-heading);
    transition: color 0.3s;
  }
  .card:hover h3 {
    color: #fff;
  }
  .kind {
    margin-top: 6px;
    font-family: var(--font-label);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-crimson);
  }
  .arrow {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--color-rule);
    border-radius: 50%;
    color: var(--color-sub);
    transition:
      background 0.3s,
      color 0.3s,
      transform 0.4s var(--ease-out-quart),
      border-color 0.3s;
  }
  .arrow:hover {
    background: var(--color-crimson);
    border-color: var(--color-crimson);
    color: #fff;
    transform: rotate(45deg);
  }
  .desc {
    margin-top: 14px;
    flex: 1;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .stores {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stores a {
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 12px;
    color: var(--color-sub);
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    transition:
      color 0.3s,
      border-color 0.3s,
      background 0.3s;
  }
  .stores a:hover {
    color: #fff;
    border-color: var(--color-crimson);
    background: rgba(225, 29, 39, 0.15);
  }
  .tags {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags span {
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 0.06em;
    padding: 4px 9px;
    color: var(--color-ghost);
    background: rgba(255, 255, 255, 0.025);
    border-radius: 2px;
    transition: color 0.3s;
  }
  .card:hover .tags span {
    color: var(--color-sub);
  }
</style>
