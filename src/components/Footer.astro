---
---

<footer class="footer">
  <div class="container inner">
    <p class="mark">Septian<span>.</span></p>
    <p class="copy">
      &copy; {new Date().getFullYear()} Septian Yoga. Built with
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
      &amp;
      <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer">Tailwind CSS</a>.
    </p>
    <a href="#hero" class="top">
      Back to top
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"></path></svg>
    </a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-rule);
    padding-block: 34px;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
    justify-content: space-between;
  }
  .mark {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.5rem;
    color: var(--color-heading);
  }
  .mark span {
    color: var(--color-crimson);
  }
  .copy {
    font-size: 12.5px;
    color: var(--color-ghost);
  }
  .copy a {
    color: var(--color-muted);
    transition: color 0.3s;
  }
  .copy a:hover {
    color: var(--color-crimson-hot);
  }
  .top {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-sub);
    transition:
      color 0.3s,
      gap 0.3s;
  }
  .top:hover {
    color: var(--color-crimson-hot);
    gap: 16px;
  }
</style>
