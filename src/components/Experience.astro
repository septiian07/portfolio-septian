---
const experiences = [
  {
    company: "BTS.id - PT Intersolusi Teknologi Asia",
    location: "Bandung, Indonesia",
    role: "Flutter Developer",
    period: "Apr 2024 — Present",
    achievements: [
      "Set up application architectures and project structures for Android and iOS using Flutter and GetX.",
      "Converted Figma UI/UX designs into application interfaces.",
      "Developed attendance and security features (MESS), including GPS tracking, mock location detection, and facial recognition.",
      "Implemented system checks to detect active developer modes and validate auto-time.",
      "Updated visual assets, color palettes, and fixed software bugs for Dinotrack.",
      "Built custom audio/video players and QR code generation (Gym App).",
      "Created RESTful API endpoints for user onboarding and class schedule management using Java Springboot.",
      "Wrote unit tests for mobile applications, achieving over 80% test coverage.",
      "Integrated Firebase Cloud Messaging (FCM) for push notifications.",
      "Collaborated with UI/UX designers, QA engineers, and backend developers.",
    ],
  },
  {
    company: "HPY Solution - PT HPY Solusi Utama Indonesia",
    location: "Jakarta, Indonesia",
    role: "Flutter Developer",
    period: "May 2022 — Nov 2023",
    achievements: [
      "Developed Flutter applications for Point of Sale (POS) and Attendance.",
      "Built layouts for multiple device sizes, and implemented barcode scanning and Bluetooth printer integration.",
      "Implemented facial recognition via Google ML Kit, location tracking, and device ID verification.",
      "Applied MVVM architecture and integrated Firebase for analytics, messaging, and crash reporting.",
      "Managed local data storage with Shared Preferences and released 3+ projects to the Google Play Store.",
      "Integrated RESTful APIs.",
    ],
  },
  {
    company: "Sampulkreativ - PT Sampul Kreatif Technology",
    location: "Cimahi, Indonesia",
    role: "Flutter Developer",
    period: "Jun 2021 — Apr 2022",
    achievements: [
      "Developed RestoApp, an online food ordering platform.",
      "Implemented UI designs from Figma in collaboration with UI/UX teams and project managers.",
      "Integrated OTP verification and Google SSO.",
      "Applied MVVM design patterns and integrated Firebase for analytics, push notifications, and crash reporting.",
      "Managed local data storage with Shared Preferences and integrated RESTful APIs.",
    ],
  },
];
const VISIBLE = 4;
---

<section id="experience" class="section">
  <div class="container">
    <div class="sec-head">
      <h2>Work <em>Experience</em></h2>
      <span class="rule"></span>
    </div>

    <div class="timeline">
      <span class="spine" aria-hidden="true"></span>
      {
        experiences.map((job, i) => (
          <article class="job" data-reveal style={`--d:${0.05}s`}>
            <span class="dot" aria-hidden="true"></span>
            <div class="meta">
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <span class="period">{job.period}</span>
              <span class="loc">{job.location}</span>
            </div>
            <div class="main">
              <h3>{job.role}</h3>
              <p class="company">{job.company}</p>
              <ul>
                {job.achievements.slice(0, VISIBLE).map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
              {job.achievements.length > VISIBLE && (
                <details>
                  <summary>
                    <span class="open">+ {job.achievements.length - VISIBLE} more highlights</span>
                    <span class="close">− Show less</span>
                  </summary>
                  <ul>
                    {job.achievements.slice(VISIBLE).map((a) => (
                      <li>{a}</li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 28px;
    padding-left: 34px;
  }
  .spine {
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-crimson), var(--color-rule) 80%, transparent);
  }
  .job {
    position: relative;
    display: grid;
    gap: 18px 50px;
    padding: 28px 28px 30px;
    border: 1px solid var(--color-rule-subtle);
    border-radius: 4px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
    transition:
      border-color 0.4s,
      background 0.4s,
      transform 0.5s var(--ease-out-quart);
  }
  .job:hover {
    border-color: rgba(225, 29, 39, 0.4);
    background: linear-gradient(180deg, rgba(225, 29, 39, 0.06), transparent);
    transform: translateX(6px);
  }
  .dot {
    position: absolute;
    left: -34px;
    top: 36px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-crimson);
    animation: pulseRing 2s infinite;
  }
  @media (min-width: 900px) {
    .job {
      grid-template-columns: 220px 1fr;
    }
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .num {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-crimson);
  }
  .period {
    font-family: var(--font-label);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-crimson-hot);
  }
  .loc {
    font-size: 13px;
    color: var(--color-ghost);
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    letter-spacing: 0.015em;
    line-height: 1.05;
    color: var(--color-heading);
  }
  .company {
    margin: 6px 0 20px;
    color: var(--color-sub);
    font-size: 15px;
  }
  ul {
    list-style: none;
    display: grid;
    gap: 11px;
  }
  li {
    position: relative;
    padding-left: 22px;
    font-size: 14.5px;
    line-height: 1.7;
  }
  li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 8px;
    height: 1px;
    background: var(--color-crimson);
  }
  details {
    margin-top: 12px;
  }
  details ul {
    margin-top: 11px;
    animation: slideDown 0.5s var(--ease-out-quart);
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: inline-block;
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-crimson);
    transition: color 0.3s;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--color-crimson-hot);
  }
  .close {
    display: none;
  }
  details[open] .open {
    display: none;
  }
  details[open] .close {
    display: inline;
  }
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>
